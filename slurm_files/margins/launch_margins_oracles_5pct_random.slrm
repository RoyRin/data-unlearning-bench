#!/bin/sh
#SBATCH --job-name=margins_compute
#SBATCH --array=0-120%6
#SBATCH --partition=kempner_h100
#SBATCH --gres=gpu:1
#SBATCH --mem=80G
#SBATCH -t 0-8:00
#SBATCH -c 1
#SBATCH --output=/n/home04/rrinberg/catered_out/klom_bench/margins_compute-oracle_random_5pct-%A__%a.out
#SBATCH --mail-user=royrinberg@gmail.com  
#SBATCH --mail-type=ALL
#SBATCH --account kempner_sham_lab

module load python/3.10.12-fasrc01
module load intelpython/3.9.16-fasrc01
module load cuda cudnn

mamba activate ffcv

CODE_DIR=/n/home04/rrinberg/code/data-unlearning-bench
pushd $CODE_DIR

# Set up paths
BASE_DIR=/n/home04/rrinberg/data_dir/KLOM_bench/nano_gpt_models/nano_gpt_models 
# Set up paths
MARGINS_FOLDER=$BASE_DIR/margins/oracle_random_5_pct/
mkdir -p $MARGINS_FOLDER

# Model checkpoint path - adjust this based on actual checkpoint location
MODEL_PATH=$BASE_DIR/oracle_random_5_pct/oracle_random_5pct_retain_${SLURM_ARRAY_TASK_ID}.pt


echo "Starting margin computation for task ${SLURM_ARRAY_TASK_ID}"

## Run the margin computation script
./launchmargins.sh "$MODEL_PATH" "$MARGINS_FOLDER"
